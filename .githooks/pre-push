#!/usr/bin/env bash
# pre-push hook — managed by repository
# Pipeline: pre-push stage hooks from .pre-commit-config.yaml (bandit,
# pytest-check, pip-audit) → UI screenshot refresh (when the push touches the
# frontend) → git-lfs upload.
# Activated automatically after: bash scripts/setup-dev.sh
# Or manually: git config core.hooksPath .githooks && chmod +x .githooks/*
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
ARGS=(hook-impl --config=.pre-commit-config.yaml --hook-type=pre-push --hook-dir "$HERE" -- "$@")

# git feeds "<local_ref> <local_sha> <remote_ref> <remote_sha>" lines on stdin.
# Capture once — both pre-commit and git-lfs need to read them.
STDIN_REFS="$(cat || true)"

if command -v python3 > /dev/null; then
    python3 tools/server_manager.py start --quiet
else
    echo '`python3` not found. Cannot launch managed test servers.' 1>&2
    exit 1
fi

cleanup() {
    python3 tools/server_manager.py stop --quiet || true
}
trap cleanup EXIT

if command -v pre-commit > /dev/null; then
    printf '%s' "$STDIN_REFS" | pre-commit "${ARGS[@]}"
else
    echo '`pre-commit` not found. Run: poetry install --with dev' 1>&2
    exit 1
fi

# ── UI screenshots (skip with OFFICE_HERO_SKIP_SCREENSHOTS=1) ────────────────
# Regenerate docs/screenshots/admin-web when any pushed commit touches the
# frontend, so the committed screenshots always match the rendered UI.
ZERO_SHA="0000000000000000000000000000000000000000"
if [ -z "${OFFICE_HERO_SKIP_SCREENSHOTS:-}" ] && [ -n "$STDIN_REFS" ]; then
    UI_TOUCHED=0
    while read -r _local_ref local_sha _remote_ref remote_sha; do
        [ -z "${local_sha:-}" ] && continue
        [ "$local_sha" = "$ZERO_SHA" ] && continue  # branch deletion
        if [ "${remote_sha:-$ZERO_SHA}" = "$ZERO_SHA" ]; then
            # New branch: compare against the default branch when available.
            RANGE_BASE="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
        else
            RANGE_BASE="$remote_sha"
        fi
        [ -z "$RANGE_BASE" ] && continue
        if git diff --name-only "$RANGE_BASE" "$local_sha" -- \
            'apps/admin-web' 'packages/api-client' 'packages/types' | grep -q .; then
            UI_TOUCHED=1
        fi
    done <<< "$STDIN_REFS"

    if [ "$UI_TOUCHED" = "1" ]; then
        bash scripts/capture-screenshots.sh
    fi
fi

# ── git-lfs ──────────────────────────────────────────────────────────────────
# core.hooksPath bypasses .git/hooks, so chain LFS explicitly or pushes of
# *.png (tracked via .gitattributes) upload broken pointers.
if command -v git-lfs > /dev/null; then
    printf '%s' "$STDIN_REFS" | git lfs pre-push "$@"
fi
