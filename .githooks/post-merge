#!/usr/bin/env bash
# .githooks/post-merge
# ─────────────────────────────────────────────────────────────────────────────
# Triggered after: git merge, git pull, git rebase
#
# Behaviour:
#   1. Reinstalls JS deps if package.json changed (pnpm install).
#   2. Deploys a fresh backend on a randomly-chosen free port via
#      scripts/manage-backend.sh deploy.  The script will:
#        • start a new uvicorn process on the chosen port
#        • wait for /health to respond
#        • kill the old instance (gracefully → SIGKILL if needed)
#        • persist the new port in .backend-port
#      If the new server fails to start, the old one is kept alive.
#
# The hook is non-blocking — missing .env skips the deploy with a warning.
# ─────────────────────────────────────────────────────────────────────────────

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$HOOK_DIR/.." && pwd)"

if [[ -t 1 ]]; then
  GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; NC='\033[0m'
else
  GREEN=''; YELLOW=''; RED=''; NC=''
fi

echo -e "${YELLOW}🔧 post-merge: running post-merge setup…${NC}"

# ── 1. JS deps ────────────────────────────────────────────────────────────────
PREV_HEAD="${1:-ORIG_HEAD}"
CHANGED=$(git -C "$PROJECT_ROOT" diff --name-only "$PREV_HEAD" HEAD 2>/dev/null || true)

if echo "$CHANGED" | grep -q 'package\.json\|pnpm-lock\.yaml'; then
  echo -e "${YELLOW}  package files changed — running pnpm install…${NC}"
  if command -v pnpm &>/dev/null; then
    (cd "$PROJECT_ROOT" && pnpm install --frozen-lockfile 2>&1 | tail -5) || \
    (cd "$PROJECT_ROOT" && pnpm install 2>&1 | tail -5)
    echo -e "${GREEN}  ✅ pnpm install complete.${NC}"
  else
    echo -e "${YELLOW}  ⚠️  pnpm not found — skipping JS install.${NC}"
  fi
fi

# ── 2. Backend deploy ─────────────────────────────────────────────────────────
DEPLOY_SCRIPT="$PROJECT_ROOT/scripts/manage-backend.sh"

if [[ ! -f "$PROJECT_ROOT/.env" ]]; then
  echo -e "${YELLOW}  ⚠️  .env missing — skipping backend deploy (copy .env.example → .env).${NC}"
  exit 0
fi

if [[ ! -x "$DEPLOY_SCRIPT" ]]; then
  echo -e "${RED}  ❌ $DEPLOY_SCRIPT not found or not executable — skipping.${NC}" >&2
  exit 0
fi

echo -e "${YELLOW}  Deploying backend…${NC}"
if bash "$DEPLOY_SCRIPT" deploy; then
  echo -e "${GREEN}✅ post-merge: backend deployed.${NC}"
else
  echo -e "${RED}❌ post-merge: backend deploy failed (see .backend-stderr.log).${NC}" >&2
  # Non-fatal — do NOT fail the merge
fi
