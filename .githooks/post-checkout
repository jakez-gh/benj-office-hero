#!/usr/bin/env bash
# .githooks/post-checkout
# ─────────────────────────────────────────────────────────────────────────────
# Triggered after: git checkout, git switch, git worktree add
#
# Branch-switch only (not file-checkout — args $1 $2 $3 where $3=1 means
# branch change, $3=0 means file checkout).
# ─────────────────────────────────────────────────────────────────────────────

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$HOOK_DIR/.." && pwd)"

if [[ -t 1 ]]; then
  GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; NC='\033[0m'
else
  GREEN=''; YELLOW=''; RED=''; NC=''
fi

# $3 = 0 means file checkout, 1 means branch switch — skip for file checkouts
BRANCH_SWITCH="${3:-1}"
if [[ "$BRANCH_SWITCH" != "1" ]]; then
  exit 0
fi

echo -e "${YELLOW}🔧 post-checkout: verifying project state…${NC}"

# ── JS deps ───────────────────────────────────────────────────────────────────
if [[ -f "$PROJECT_ROOT/package.json" ]] && [[ ! -d "$PROJECT_ROOT/node_modules" ]]; then
  echo -e "${YELLOW}  node_modules missing — run: pnpm install${NC}"
elif command -v pnpm &>/dev/null; then
  # Only re-install if lock file changed compared to the previous HEAD
  PREV_HEAD="$1"
  CURR_HEAD="$2"
  if git -C "$PROJECT_ROOT" diff --name-only "$PREV_HEAD" "$CURR_HEAD" 2>/dev/null \
       | grep -q 'pnpm-lock\.yaml'; then
    echo -e "${YELLOW}  lock file changed — running pnpm install…${NC}"
    (cd "$PROJECT_ROOT" && pnpm install 2>&1 | tail -5)
  fi
fi

# ── Backend deploy ─────────────────────────────────────────────────────────────
DEPLOY_SCRIPT="$PROJECT_ROOT/scripts/manage-backend.sh"
if [[ -f "$PROJECT_ROOT/.env" ]] && [[ -x "$DEPLOY_SCRIPT" ]]; then
  echo -e "${YELLOW}  Deploying backend after branch switch…${NC}"
  if bash "$DEPLOY_SCRIPT" deploy 2>&1; then
    echo -e "${GREEN}✅ post-checkout: backend deployed.${NC}"
  else
    echo -e "${RED}⚠️  post-checkout: backend deploy failed (see .backend-stderr.log).${NC}"
    # Non-fatal
  fi
elif [[ ! -f "$PROJECT_ROOT/.env" ]]; then
  echo -e "${YELLOW}  ⚠️  .env missing — skipping backend deploy.${NC}"
fi

echo -e "${GREEN}✅ post-checkout: done.${NC}"
