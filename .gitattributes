# Normalize line endings
* text=auto eol=lf
# Python
*.py text eol=lf
*.pyi text eol=lf
# Shell scripts
*.sh text eol=lf
# Windows scripts (keep CRLF)
*.ps1 text eol=crlf
*.bat text eol=crlf
# Docs
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
# Binary / LFS
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.bmp binary
*.ico binary
*.webp filter=lfs diff=lfs merge=lfs -text
*.tiff binary
*.pdf binary
